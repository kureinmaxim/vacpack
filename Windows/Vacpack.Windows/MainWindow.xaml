<Window x:Class="Vacpack.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Vacpack.Windows" Title="Vacpack — Windows"
 Width="1100" Height="680" MinWidth="680" MinHeight="540" WindowStartupLocation="CenterScreen"
 Background="#F6F7F9" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}"
 Icon="Resources/AppIcon.png" AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
 PreviewKeyDown="WindowKeyDown" Closing="OnClosing">
 <Grid Margin="18,12,18,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Image Source="Resources/AppIcon.png" Width="34" Height="34" Margin="0,0,10,0" />
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock Text="Vacpack" FontSize="19" FontWeight="SemiBold" />
    <TextBlock Text="{l:T 'Сжатие фото, видео и GIF'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0" />
   </StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <ComboBox x:Name="LanguageBox" Width="96" Height="24" FontSize="11" MinHeight="0" Margin="0,0,8,0" SelectionChanged="LanguageChanged" ToolTip="{l:T 'Язык'}" AutomationProperties.Name="{l:T 'Язык'}">
      <ComboBoxItem Content="English" Tag="en" /><ComboBoxItem Content="Русский" Tag="ru" />
     </ComboBox>
     <Border Background="#E9EDF2" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{l:T 'Экспериментальная версия'}" FontSize="11" Foreground="{StaticResource Muted}" /></Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
     <TextBlock x:Name="VersionText" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" />
     <TextBlock Text="  ·  " Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" />
     <TextBlock Text="{l:T 'Разработчик: Kurein M.N. · '}" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" />
     <Button Click="OpenProjectPage" Style="{StaticResource LinkButton}" MinHeight="0" Padding="0" ToolTip="{l:T 'Открыть страницу проекта на GitHub'}" AutomationProperties.Name="{l:T 'Страница проекта на GitHub'}">
      <TextBlock Text="github.com/kureinmaxim/vacpack" FontSize="11" Foreground="#416B94" TextDecorations="Underline" />
     </Button>
    </StackPanel>
   </StackPanel>
  </Grid>
  <Border x:Name="ToolsBanner" Grid.Row="1" Background="#FFF5DD" BorderBrush="#ECD49A" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,8">
   <DockPanel><Button DockPanel.Dock="Right" Content="{l:T 'Указать папку…'}" Click="ChooseTools" Margin="12,0,0,0" />
    <TextBlock x:Name="ToolsText" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="248" /></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8" x:Name="FileActions">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="{l:T 'Файлы'}" FontSize="15" FontWeight="SemiBold" />
      <Border Background="#E9EDF2" CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="CountText" Text="0" FontSize="12" /></Border>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Content="{l:T '+  Добавить файлы'}" Padding="10,3" MinHeight="26" Click="ChooseFiles" ToolTip="{l:T 'Добавить файлы (Ctrl+O)'}" Margin="0,0,7,0" />
      <Button Content="{l:T 'Папку…'}" Padding="10,3" MinHeight="26" Click="ChooseFolder" Margin="0,0,7,0" />
      <Button x:Name="ClearButton" Click="ClearFiles" Style="{StaticResource IconButton}" ToolTip="{l:T 'Очистить список'}" AutomationProperties.Name="{l:T 'Очистить список'}">
       <Path Data="M 3,4 L 13,4 M 6,1 L 10,1 M 4,4 L 5,15 L 11,15 L 12,4 M 7,7 L 7,12 M 9,7 L 9,12" Stroke="#68717E" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform" />
      </Button>
     </StackPanel>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Background="White" ClipToBounds="True">
     <Grid>
      <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
       CanUserResizeRows="False" CanUserReorderColumns="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F4" BorderThickness="0"
       Background="White" RowBackground="White" SelectionMode="Extended" SelectionUnit="FullRow"
       HeadersVisibility="Column" RowHeaderWidth="0" EnableRowVirtualization="True" KeyDown="FilesKeyDown"
       MouseDoubleClick="OpenSelected" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
       <DataGrid.RowStyle><Style TargetType="DataGridRow">
        <Setter Property="ToolTip" Value="{Binding Details}" /><Setter Property="Background" Value="White" />
        <Style.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FAFBFD" /></Trigger>
         <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFF8E7" /></Trigger>
        </Style.Triggers>
       </Style></DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="{l:T 'Имя файла'}" Width="*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Width="46" Height="36" CornerRadius="6" Background="{Binding KindBackground}" VerticalAlignment="Top" ClipToBounds="True">
           <Grid>
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVisibility}}" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding KindIcon}" Foreground="{Binding KindColor}" FontSize="{Binding KindIconSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowTextIcon, Converter={StaticResource BoolVisibility}}" />
            <Path Data="M 1,2 L 17,2 L 17,16 L 1,16 Z M 1,13 L 6,8 L 10,12 L 13,9 L 17,13 M 5,5 A 1,1 0 1 0 5,7 A 1,1 0 1 0 5,5" Stroke="{Binding KindColor}" StrokeThickness="1.3" Width="19" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowImageIcon, Converter={StaticResource BoolVisibility}}" />
            <Grid Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVisibility}}">
             <Border Visibility="{Binding ShowThumbnailBadge, Converter={StaticResource BoolVisibility}}" Background="#B8252932" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3" Padding="4,1">
              <TextBlock Text="{Binding ThumbnailBadge}" Foreground="White" FontSize="8" />
             </Border>
            </Grid>
           </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" LineHeight="18" />
           <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
           <ProgressBar Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" Height="3" Foreground="{StaticResource Ochre}" Background="#ECEFF3" BorderThickness="0" Margin="0,6,0,0" />
          </StackPanel>
         </Grid>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{l:T 'Размер'}" Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel>
          <TextBlock Text="{Binding InputSize}" Foreground="{StaticResource Muted}" FontSize="12" />
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="→" Foreground="#A0A7B1" Margin="0,0,7,0" /><TextBlock Text="{Binding OutputSize}" FontWeight="SemiBold" /></StackPanel>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{l:T 'Результат'}" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel>
          <TextBlock Text="{Binding Saved}" Foreground="{Binding StatusColor}" FontSize="15" FontWeight="SemiBold" Visibility="{Binding HasResult, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,5" />
          <Border Background="{Binding StatusBackground}" CornerRadius="4" Padding="7,3" HorizontalAlignment="Left">
           <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10.5" />
          </Border>
          <Button Content="{l:T 'Подробнее'}" Click="ShowItemDetails" Style="{StaticResource LinkButton}" FontSize="11" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" />
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Width="64">
         <DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,12" /></Style></DataGridTemplateColumn.CellStyle>
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal">
          <Button Click="OpenItemFolder" Style="{StaticResource IconButton}" ToolTip="{l:T 'Показать файл в папке'}" AutomationProperties.Name="{l:T 'Показать файл в папке'}">
           <Path Data="M 1,4 L 6,4 L 8,6 L 16,6 L 16,15 L 1,15 Z M 1,7 L 16,7" Stroke="#68717E" StrokeThickness="1.3" Width="14" Height="12" Margin="1" Stretch="Uniform" StrokeLineJoin="Round" />
          </Button>
          <Button Click="RemoveItem" Style="{StaticResource IconButton}" IsEnabled="{Binding CanRemove}" ToolTip="{l:T 'Убрать из списка'}" AutomationProperties.Name="{l:T 'Убрать файл из списка'}">
           <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="#929BA7" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
          </Button>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <Grid x:Name="EmptyState" Margin="10">
       <Rectangle Stroke="#E2E6EC" StrokeThickness="1.3" StrokeDashArray="4 4" RadiusX="10" RadiusY="10" />
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
        <Image Source="Resources/AppIcon.png" Width="48" Height="48" Margin="0,0,0,10" />
        <TextBlock Text="{l:T 'Перетащите файлы сюда'}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="{l:T 'Фото, видео, GIF или папку целиком'}" Foreground="{StaticResource Muted}" Margin="0,4,0,12" TextAlignment="Center" />
        <Button Content="{l:T 'Выбрать файлы…'}" Click="ChooseFiles" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="16,5" />
        <TextBlock Text="{l:T 'Исходники сохранятся. Обработка — на вашем компьютере.'}" Style="{StaticResource Label}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="0,10,0,0" />
       </StackPanel>
      </Grid>
      <Border x:Name="DropHint" Visibility="Collapsed" Background="#F2FFF6DF" BorderBrush="#D9A033" BorderThickness="2" CornerRadius="9" IsHitTestVisible="False">
       <TextBlock Text="{l:T 'Отпустите, чтобы добавить файлы'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
      </Border>
     </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,6,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock x:Name="QueueHint" Text="{l:T 'Можно добавлять файлы и папки'}" Style="{StaticResource Label}" />
     <TextBlock Grid.Column="1" Text="{l:T 'Delete — убрать из списка'}" FontSize="11" Foreground="#89919D" />
    </Grid>
   </Grid>
   <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <StackPanel Margin="16,12,16,8">
      <TextBlock Text="{l:T 'Настройки'}" FontSize="15" FontWeight="SemiBold" />
      <TextBlock Text="{l:T 'Применяются ко всей очереди'}" Style="{StaticResource Label}" Margin="0,2,0,0" />
     </StackPanel>
     <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,6,0">
      <StackPanel x:Name="SettingsPanel">
       <Label Target="{Binding ElementName=QualityBox}" Content="{l:T 'Качество'}" />
       <ComboBox x:Name="QualityBox" SelectedIndex="2" SelectionChanged="SettingsChanged" AutomationProperties.Name="{l:T 'Качество'}">
        <ComboBoxItem Content="{l:T 'Наивысшее'}" /><ComboBoxItem Content="{l:T 'Высокое'}" /><ComboBoxItem Content="{l:T 'Хорошее'}" /><ComboBoxItem Content="{l:T 'Среднее'}" /><ComboBoxItem Content="{l:T 'Приемлемое'}" />
       </ComboBox>
       <TextBlock x:Name="QualityHint" Text="{l:T 'Баланс качества и размера'}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,8" />
       <StackPanel x:Name="ImageOptions" Margin="0,0,0,8">
        <Label Target="{Binding ElementName=ImageFormatBox}" Content="{l:T 'Формат фото'}" />
        <ComboBox x:Name="ImageFormatBox" SelectedIndex="0" SelectionChanged="SettingsChanged" AutomationProperties.Name="{l:T 'Формат фото'}">
         <ComboBoxItem Content="{l:T 'Как в исходнике'}" /><ComboBoxItem Content="JPEG" /><ComboBoxItem Content="{l:T 'PNG · без потерь'}" /><ComboBoxItem Content="WebP" /><ComboBoxItem Content="AVIF" />
        </ComboBox>
       </StackPanel>
       <StackPanel x:Name="VideoOptions" Margin="0,0,0,8">
        <Label Target="{Binding ElementName=VideoFormatBox}" Content="{l:T 'Формат видео'}" />
        <ComboBox x:Name="VideoFormatBox" SelectedIndex="0" SelectionChanged="SettingsChanged" AutomationProperties.Name="{l:T 'Формат видео'}">
         <ComboBoxItem Content="{l:T 'Как в исходнике'}" /><ComboBoxItem Content="MP4 · H.264" /><ComboBoxItem Content="WebM · VP9" /><ComboBoxItem Content="GIF" /><ComboBoxItem Content="{l:T 'Звук · M4A'}" /><ComboBoxItem Content="{l:T 'Звук · MP3'}" /><ComboBoxItem Content="{l:T 'Звук · Opus'}" />
        </ComboBox>
       </StackPanel>
       <StackPanel x:Name="SizeOptions" Margin="0,0,0,8">
        <Label Target="{Binding ElementName=SizeBox}" Content="{l:T 'Длинная сторона'}" />
        <ComboBox x:Name="SizeBox" SelectedIndex="0" AutomationProperties.Name="{l:T 'Длинная сторона'}">
         <ComboBoxItem Content="{l:T 'Исходный размер'}" Tag="0" /><ComboBoxItem Content="{l:T 'Не более 3840 px'}" Tag="3840" /><ComboBoxItem Content="{l:T 'Не более 2560 px'}" Tag="2560" /><ComboBoxItem Content="{l:T 'Не более 1920 px'}" Tag="1920" /><ComboBoxItem Content="{l:T 'Не более 1280 px'}" Tag="1280" /><ComboBoxItem Content="{l:T 'Не более 800 px'}" Tag="800" /><ComboBoxItem Content="{l:T 'Не более 640 px'}" Tag="640" /><ComboBoxItem Content="{l:T 'Не более 480 px'}" Tag="480" /><ComboBoxItem Content="{l:T 'Не более 320 px'}" Tag="320" />
        </ComboBox>
       </StackPanel>
       <Grid x:Name="FpsOptions" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel x:Name="VideoFpsOptions"><Label Target="{Binding ElementName=VideoFpsBox}" Content="{l:T 'Кадров/с, видео'}" /><ComboBox x:Name="VideoFpsBox" SelectedIndex="0" AutomationProperties.Name="{l:T 'Частота кадров видео'}">
         <ComboBoxItem Content="{l:T 'Исходная'}" Tag="0" /><ComboBoxItem Content="60" Tag="60" /><ComboBoxItem Content="30" Tag="30" /><ComboBoxItem Content="24" Tag="24" /><ComboBoxItem Content="15" Tag="15" /><ComboBoxItem Content="12" Tag="12" /><ComboBoxItem Content="10" Tag="10" /><ComboBoxItem Content="6" Tag="6" />
        </ComboBox></StackPanel>
        <StackPanel x:Name="GifFpsOptions" Grid.Column="2"><Label Target="{Binding ElementName=GifFpsBox}" Content="{l:T 'Кадров/с, GIF'}" /><ComboBox x:Name="GifFpsBox" SelectedIndex="1" AutomationProperties.Name="{l:T 'Частота кадров GIF'}">
         <ComboBoxItem Content="10" Tag="10" /><ComboBoxItem Content="15" Tag="15" /><ComboBoxItem Content="20" Tag="20" /><ComboBoxItem Content="30" Tag="30" /><ComboBoxItem Content="50" Tag="50" />
        </ComboBox></StackPanel>
       </Grid>
       <CheckBox x:Name="RemoveAudioBox" Content="{l:T 'Убрать звук из видео'}" />
       <CheckBox x:Name="SpeechBox" Content="{l:T 'Речь / подкаст'}" ToolTip="{l:T 'Для звуковых файлов: моно, выравнивание громкости и низкий битрейт'}" />
       <Expander Header="{l:T 'Дополнительно'}" Margin="0,6,0,12" FontSize="12" Foreground="{StaticResource Muted}">
        <StackPanel Margin="0,10,0,0">
         <CheckBox x:Name="DatesBox" Content="{l:T 'Сохранить даты файлов'}" IsChecked="True" />
         <Expander x:Name="ExperimentalOptions" Expanded="ExperimentalExpanded" Header="{l:T 'Сильное сжатие (экспериментально)'}" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Muted}">
          <StackPanel Margin="0,8,0,0">
           <Label Target="{Binding ElementName=PresetBox}" Content="{l:T 'Шаблон'}" />
           <ComboBox x:Name="PresetBox" SelectedIndex="0" SelectionChanged="PresetChanged" AutomationProperties.Name="{l:T 'Шаблон'}" ToolTip="{l:T 'Выставляет размер, частоту кадров, звук и фильтры ниже; их можно поправить'}">
            <ComboBoxItem Content="{l:T 'Свои настройки'}" /><ComboBoxItem Content="{l:T 'Сильное'}" /><ComboBoxItem Content="{l:T 'Максимальное'}" /><ComboBoxItem Content="{l:T 'Предельное'}" />
           </ComboBox>
           <Label Target="{Binding ElementName=CodecBox}" Content="{l:T 'Видеокодек'}" Margin="0,8,0,0" />
           <ComboBox x:Name="CodecBox" SelectedIndex="0" AutomationProperties.Name="{l:T 'Видеокодек'}">
            <ComboBoxItem Content="{l:T 'Стандартный (H.264 / VP9)'}" /><ComboBoxItem Content="AV1 (SVT-AV1)" /><ComboBoxItem Content="HEVC (H.265)" /><ComboBoxItem Content="{l:T 'H.266 / VVC · очень медленно'}" />
           </ComboBox>
           <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="TargetBox" Content="{l:T 'Уложить в'}" VerticalAlignment="Center" Margin="0,0,8,0" Checked="TargetToggled" Unchecked="TargetToggled" ToolTip="{l:T 'Сколько мегабайт файл может занять самое большее. Битрейт подбирается под это; длительность должна быть известна.'}" />
            <TextBox x:Name="TargetMbBox" Text="10" Width="56" Height="24" VerticalContentAlignment="Center" IsEnabled="False" AutomationProperties.Name="{l:T 'Целевой размер, МБ'}" />
            <TextBlock Text="{l:T 'МБ'}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,0,0" />
           </StackPanel>
           <Label Target="{Binding ElementName=AudioBox}" Content="{l:T 'Звук'}" Margin="0,8,0,0" />
           <ComboBox x:Name="AudioBox" SelectedIndex="0" AutomationProperties.Name="{l:T 'Звук'}">
            <ComboBoxItem Content="{l:T 'Как обычно'}" Tag="0" /><ComboBoxItem Content="{l:T 'Моно · 32 кбит/с'}" Tag="32" /><ComboBoxItem Content="{l:T 'Моно · 16 кбит/с'}" Tag="16" /><ComboBoxItem Content="{l:T 'Моно · 8 кбит/с'}" Tag="8" />
           </ComboBox>
           <CheckBox x:Name="GrayBox" Content="{l:T 'Чёрно-белое'}" Margin="0,8,0,4" />
           <CheckBox x:Name="DenoiseBox" Content="{l:T 'Убрать шум'}" ToolTip="{l:T 'Сглаживает шум и зерно: картинка мягче, но кодеру нужно меньше битов'}" />
           <CheckBox x:Name="DedupBox" Content="{l:T 'Пропускать повторы кадров'}" ToolTip="{l:T 'Выбрасывает кадры, почти не отличающиеся от предыдущего; хорошо для слайдов и записи экрана'}" />
           <TextBlock Text="{l:T 'Эксперимент: медленнее, картинка теряет детали. AV1, H.266 и звук Opus в MP4 могут не открыться в старых плеерах.'}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
         </Expander>
         <TextBlock Text="{l:T 'Размеры и частота кадров только уменьшаются. PNG сжимается без потерь.'}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,9,16,10">
      <StackPanel x:Name="OutputPanel">
       <TextBlock Text="{l:T 'Сохранить'}" Style="{StaticResource Label}" Margin="0,0,0,8" />
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="OutputText" Text="{l:T 'Рядом с исходником'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{l:T 'Отдельный файл, без перезаписи'}" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
        <Button Grid.Column="1" Click="ChooseOutput" Style="{StaticResource IconButton}" ToolTip="{l:T 'Выбрать папку'}" AutomationProperties.Name="{l:T 'Выбрать папку вывода'}" Margin="8,0,0,0">
         <Path Data="M 1,4 L 6,4 L 8,6 L 16,6 L 16,15 L 1,15 Z M 1,7 L 16,7" Stroke="#68717E" StrokeThickness="1.3" Width="14" Height="12" Margin="1" Stretch="Uniform" StrokeLineJoin="Round" />
        </Button>
       </Grid>
       <Button x:Name="ResetOutputButton" Content="{l:T 'Вернуть папку исходника'}" Click="ResetOutput" Style="{StaticResource LinkButton}" FontSize="11" Visibility="Collapsed" Margin="0,6,0,0" />
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
    <TextBlock x:Name="SummaryText" Text="{l:T 'Исходники останутся на месте'}" FontSize="14" FontWeight="SemiBold" />
    <TextBlock x:Name="StatusText" Text="{l:T 'Сохраним результат, только если файл станет меньше'}" Style="{StaticResource Label}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="CancelButton" Content="{l:T 'Остановить'}" Click="CancelJobs" Visibility="Collapsed" Padding="16,7" MinWidth="130" />
    <Button x:Name="CompressButton" Content="{l:T 'Сжать файлы'}" Click="StartCompression" Style="{StaticResource PrimaryButton}" ToolTip="{l:T 'Запустить сжатие (Ctrl+Enter)'}" MinWidth="150" Padding="18,7" IsEnabled="False" />
   </StackPanel>
  </Grid>
 </Grid>
</Window>
